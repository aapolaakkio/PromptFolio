{
  "name": "promptfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "build": "bun run build.ts",
    "db:generate": "drizzle-kit generate",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src e2e",
    "fmt:check": "oxfmt --check src e2e",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@better-auth/cli": "1.5.0-beta.13",
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^7"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@tanstack/charts": "^0.16",
    "@tanstack/react-charts": "^0.16",
    "@tanstack/react-query": "^5.102",
    "@tanstack/react-router": "^1.170",
    "better-auth": "1.7.2",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.3",
    "zod": "^4"
  }
}
