{
  "name": "promptfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "build": "vite build",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "fmt": "oxfmt src e2e '!src/web/routeTree.gen.ts'",
    "fmt:check": "oxfmt --check src e2e '!src/web/routeTree.gen.ts'",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run test:cov",
    "prepare": "simple-git-hooks",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@node-rs/argon2": "^2.1.0",
    "@tanstack/charts": "^0.16.0",
    "@tanstack/react-charts": "^0.16.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "1.7.2",
    "croner": "^10.0.1",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.8.1",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "lint-staged": "^17.4.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS='--experimental-strip-types' pnpm exec lint-staged"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.24.0"
}
