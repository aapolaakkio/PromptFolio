{
  "name": "promptfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "bun --hot src/server/index.ts",
    "start": "NODE_ENV=production bun src/server/index.ts",
    "build": "bun run build.ts",
    "db:generate": "drizzle-kit generate",
    "test": "bun test",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src e2e",
    "fmt:check": "oxfmt --check src e2e",
    "check": "bun run lint && bun run fmt:check && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.80.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@tanstack/charts": "^0.16.0",
    "@tanstack/react-charts": "^0.16.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "better-auth": "1.7.2",
    "drizzle-orm": "1.0.0-rc.5-169397b",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "unpdf": "^1.8.1",
    "zod": "^4.5.2"
  }
}
