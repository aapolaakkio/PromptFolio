{
  "name": "promptfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate:local && vite dev",
    "build": "vite build",
    "deploy": "vite build && pnpm db:migrate && wrangler deploy",
    "preview": "vite build && pnpm db:migrate:local && wrangler dev --port 3000",
    "cf-typegen": "wrangler types --env-file .env.example",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio --config drizzle.studio.config.ts",
    "db:migrate": "wrangler d1 migrations apply promptfolio --remote",
    "db:migrate:local": "wrangler d1 migrations apply promptfolio --local",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions",
    "fmt": "oxfmt src e2e '!src/web/routeTree.gen.ts'",
    "fmt:check": "oxfmt --check src e2e '!src/web/routeTree.gen.ts'",
    "check": "pnpm run lint && pnpm run fmt:check && pnpm run typecheck && pnpm run test:cov",
    "prepare": "simple-git-hooks",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@tanstack/charts": "^1.5.0",
    "@tanstack/react-charts": "^1.5.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.18",
    "drizzle-orm": "1.0.0-rc.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@oxlint/plugins": "1.92.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "1.0.0-rc.5",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS='--experimental-strip-types' pnpm exec lint-staged"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
