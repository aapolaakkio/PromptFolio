# Local development values for `pnpm run dev`. Copy to `.env` and fill in.
#
# This file is also what `wrangler types` reads to type `Cloudflare.Env`
# (see the cf-typegen script), so every key the server reads belongs here --
# with a placeholder, never a real value. In production these are secrets set
# with `wrangler secret put NAME`, not entries in wrangler.jsonc.

# Generate with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
# Must be at least 32 characters. The Worker refuses to serve without a real
# secret here -- a default or missing value would be a silent auth bypass.
BETTER_AUTH_SECRET=replace-with-a-real-generated-secret-at-least-32-chars

# The deployed origin. Better Auth builds callback URLs from it.
BASE_URL=http://localhost:3000

# This is a closed, family instance. The very first account is created through
# the login page itself (no setting needed for that -- see README). Leave this
# "false" normally; set it to "true" only while adding an account for another
# family member, then set it back.
ALLOW_SIGNUP=false

# Enables the assistant (Avustaja) and the classification of new payees during
# a bank import. Both call Anthropic's API and cost money -- cents per question
# or import. Leave it empty and neither runs: chat answers 503 and
# classification is skipped, while everything else works unchanged.
ANTHROPIC_API_KEY=

# Authorises POST /api/cron/refresh, the price and FX refresh:
#
#   curl -fsS -X POST -H "authorization: Bearer $CRON_SECRET" \
#     https://your-worker.workers.dev/api/cron/refresh
#
# The scheduled refresh does not need it -- the Cron Trigger in wrangler.jsonc
# calls the Worker's own `scheduled` handler, which never crosses HTTP. This is
# only for running one by hand. Empty means the endpoint refuses every call.
CRON_SECRET=
