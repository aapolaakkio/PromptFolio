# Generate with: node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
# Must be at least 32 characters. The process refuses to boot without a real
# secret here - a default or missing value would be a silent auth bypass.
BETTER_AUTH_SECRET=replace-with-a-real-generated-secret-at-least-32-chars

BASE_URL=http://localhost:3000

# This is a closed, family instance. The very first account is created
# through the login page itself (no setting needed for that -- see README).
# Leave this unset (or "false") normally; set it to "true" only while adding
# an account for another family member afterwards, then unset it again.
ALLOW_SIGNUP=false

# Where the SQLite file lives. Ignored under Docker, which mounts a volume at
# /data and sets this itself.
# DATABASE_PATH=./data/promptfolio.db

# HTTP port. Change the published port in compose.yaml too if you change this.
# PORT=3000

# Enables the assistant (Avustaja) and the classification of new payees during
# a bank import. Both call Anthropic's API and cost money -- cents per question
# or import. Leave unset and neither runs: chat answers 503 and classification
# is skipped, while everything else works unchanged.
# ANTHROPIC_API_KEY=sk-ant-...

# Authorises POST /api/cron/refresh, which fetches the day's prices and FX
# rates. Call it from your own cron -- the app schedules nothing itself:
#
#   curl -fsS -X POST -H "authorization: Bearer $CRON_SECRET" \
#     localhost:3000/api/cron/refresh
#
# Leave it unset and the endpoint refuses every call, so prices stay as they are.
# CRON_SECRET=replace-with-a-real-generated-secret
