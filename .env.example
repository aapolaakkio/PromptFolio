# Generate with: bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
# Must be at least 32 characters. The process refuses to boot without a real
# secret here - a default or missing value would be a silent auth bypass.
BETTER_AUTH_SECRET=replace-with-a-real-generated-secret-at-least-32-chars

BASE_URL=http://localhost:3000

# This is a closed, family instance. Leave unset (or "false") normally.
# Set to "true" only while creating a new account, then unset it again.
ALLOW_SIGNUP=false

# DATABASE_PATH=./data/promptfolio.db
