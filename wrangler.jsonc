{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promptfolio",
  "compatibility_date": "2026-09-01",
  // node:crypto and node:buffer (import hashing) need this to resolve at build.
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  // Weekdays 18:00 UTC (after exchanges close and funds publish); hourly otherwise for intraday prices and paused lookups (the run skips hours when no exchange is open).
  "triggers": { "crons": ["0 18 * * 1-5", "0 0-17,19-23 * * 1-5"] },
  "observability": { "enabled": true },
  // Only used to resolve the AI Gateway URL for Claude calls (AI_GATEWAY_ID).
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "promptfolio",
      // Filled in by `wrangler d1 create promptfolio`.
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "drizzle",
      // drizzle-kit writes `<name>/migration.sql`, not the flat `*.sql` wrangler expects.
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "vars": {
    "BASE_URL": "http://localhost:3000",
    "ALLOW_SIGNUP": "false",
  },
}
